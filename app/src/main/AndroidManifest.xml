<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No INTERNET permission on purpose: notification contents never leave the watch.
      Notification access is not a runtime permission - it is granted by the user in
      Settings (or via adb), and enforced by BIND_NOTIFICATION_LISTENER_SERVICE below.
    -->

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WristMarkRead">

        <!-- Standalone Wear OS app: it does not need a companion phone app to be useful. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.WristMarkRead">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Bound by the system (a different process), so it must be exported. It is protected
          by BIND_NOTIFICATION_LISTENER_SERVICE, a signature-level permission only the
          platform holds, so no third-party app can bind to it.
        -->
        <service
            android:name=".notification.MarkReadNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
